# Copy to .env and fill in. Never commit .env.
# Read-only PostgreSQL/PostGIS role (see README -> "Database"):
DATABASE_URL=postgresql://geovision_ro:<password>@127.0.0.1:15432/gisdb
# Public KazEOSat catalog service
CATALOG_URL=https://old-eo.gharysh.kz/CatalogService
# 0 = strictly read-only (default). 1 = /catalog/area re-fetches recent days into the DB (needs a writable role).
CATALOG_REFRESH=0
LOOKBACK_DAYS=3
MODEL_NAME=unet_kazeosat_finetuned_v4
